#1
база данных - хранилище данных,
субд - управление базы данных,
sql - язык для управления базы данных

postgresql отличается от sqlite - масштабом 

#2
psql - это консольная команда для управления базы данных
\l - показать все бд 
\dt - все таблицы 
\q - выход из управления 
SELECT current_database() - текущая база данных 

#3
CREATE TABLE - создает таблицу
INSERT - добавляет
SELECT  - читает (выводит)
UPDATE - изменяет
DELETE - удаляет
изменяют insert, update, delete

#4
primare key - уникальный id (не повторяется, не может быть пустым)
foreing key - связывает таблицу с другим
unique - запрещает дубликаты
not null - запрещает оставлять поле пустым 
default - сам пишет значение если не ввели 
check - проверяет данные на условие 

#5 
join - объединяет данные из разных таблиц 
group by - групирует строки
having - фильтрует уже сгруппированные данные 
отличие having от where это очередность (этап)

#6
commit - потверждает и сохраняет изменения 
rollback - отменяет все изменения 

#7
индекс - поиск 

